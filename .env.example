# Copy to .env and fill in for live mode. Fake mode needs only TIMEZONE.

# fake | live
GATEWAY=fake

# --- required in every mode ---
# The household's IANA zone; Schedule Rules are interpreted in it. No default: "system
# local" resolves to UTC inside a container and shifts every schedule silently.
TIMEZONE=Australia/Sydney

# --- live mode: all required (the app refuses to run live without them) ---
ROBOROCK_EMAIL=
ROBOROCK_DUID=
# Carpet-mode integers as reported by discover.py (get_carpet_mode) on your firmware.
# No defaults in live mode: a wrong value would wet a carpet.
CARPET_RISE_VALUE=
CARPET_AVOID_VALUE=

# --- optional ---
POLL_INTERVAL_SEC=5
APP_PORT=8000
SESSION_PATH=user_data.json

# Natural-language previews and recorded-history summaries through Claude Agent SDK.
# Authenticate Claude Code as the same user running the server, or set ANTHROPIC_API_KEY.
# Robot actions still require explicit confirmation in the app.
ASSISTANT_ENABLED=false
ASSISTANT_MODEL=sonnet
