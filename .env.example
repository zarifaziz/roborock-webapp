# Copy to .env and fill in for live mode. Fake mode needs none of this.

# fake | live
GATEWAY=fake

# --- live mode: all required (the app refuses to run live without them) ---
ROBOROCK_EMAIL=
ROBOROCK_DUID=
# Carpet-mode integers as reported by discover.py (get_carpet_mode) on your firmware.
# No defaults in live mode: a wrong value would wet a carpet.
CARPET_RISE_VALUE=
CARPET_AVOID_VALUE=

# --- optional ---
POLL_INTERVAL_SEC=5
APP_PORT=8000
SESSION_PATH=user_data.json
