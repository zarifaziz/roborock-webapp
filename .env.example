# Copy to .env and fill in for live mode. Fake mode needs none of this.

# fake | live
GATEWAY=fake

# --- live mode only (fill after running discover.py) ---
ROBOROCK_EMAIL=
ROBOROCK_DUID=
VACUUM_SCENE_ID=
MOP_SCENE_ID=
# Carpet-mode integers as reported by discover.py (get_carpet_mode) on your firmware.
CARPET_RISE_VALUE=0
CARPET_AVOID_VALUE=1

# --- optional ---
POLL_INTERVAL_SEC=5
APP_PORT=8000
SESSION_PATH=user_data.json
